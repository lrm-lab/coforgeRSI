{
  "backend": {
    "type": "command",
    "command": ["{python}", "{project}/examples/demo_agent.py"]
  },
  "verifier": {
    "mode": "json",
    "command": ["{python}", "{project}/examples/demo_verifier.py", "{workspace}"],
    "check_ids": ["integer_domain", "minimum"],
    "authority": "user_provided"
  },
  "limits": {
    "max_rounds": 3,
    "max_agent_calls": 20,
    "max_seconds": 60,
    "agent_timeout": 10,
    "verifier_timeout": 10,
    "parallelism": 2,
    "verification_repeats": 2
  }
}
